# JobIndex S1 environment template
# Copy to .env and fill in values. Never commit .env.

# Postgres connection URL for the application and migrations.
# Local docker compose default:
JOBINDEX_DATABASE_URL=postgresql+asyncpg://jobindex:jobindex@localhost:5432/jobindex

# Identifiable User-Agent on every outbound request.
# A blank UA is a config error, not a default.
# Format: ProductName/Version (+URL; contact=email)
JOBINDEX_USER_AGENT=JobIndexBot/0.1 (+https://example.invalid/jobindex; contact=ops@example.invalid)

# Optional: directory from which per-source secrets are read as files.
# If set, secret for source <id> is read from $JOBINDEX_SECRET_DIR/<id>.
# If not set, secrets are resolved from JOBINDEX_SECRET_<id> env vars.
# JOBINDEX_SECRET_DIR=/run/secrets

# Optional: override log level (DEBUG, INFO, WARNING, ERROR)
# JOBINDEX_LOG_LEVEL=INFO

# Optional: HTTP timeout and concurrency knobs
# JOBINDEX_HTTP_TIMEOUT_S=20.0
# JOBINDEX_MAX_CONCURRENCY_PER_HOST=1
# JOBINDEX_REQUEST_JITTER_MS=250